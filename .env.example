# ============================================
# Coze Platform Database (Auto-injected)
# ============================================
# These variables are automatically injected by the Coze platform after database integration is enabled.
COZE_SUPABASE_URL=
COZE_SUPABASE_ANON_KEY=
COZE_SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# Development & Preview Mode
# ============================================
# Local and Coze development preview only. Production ignores these flags.
ENABLE_UI_PREVIEW=true
ENABLE_AI_FIXTURE=true
PREVIEW_SIGNING_SECRET=replace-with-a-long-random-value

# ============================================
# Runtime Environment (Auto-injected)
# ============================================
# Coze injects DEV/PROD. Set DEV explicitly only when testing the built package locally with preview identity.
COZE_PROJECT_ENV=DEV

# Coze runtime domain (Auto-injected in production)
# Example: https://your-project-id.coze.site
COZE_PROJECT_DOMAIN_DEFAULT=

# ============================================
# Chaoxing OAuth Configuration
# ============================================
# Keep disabled until APPID, SECRET, FIDs, and HTTPS callback are configured in both Coze and Chaoxing platform.

# Enable/disable Chaoxing authentication
ENABLE_CHAOXING_AUTH=false

# Application credentials (Provided by Chaoxing Open Platform)
CHAOXING_APPID=
CHAOXING_SECRET=
# Allowed institution FIDs (comma-separated)
# Format: FID or FID:Name
# Example: 1024 or 1024:武汉大学,1385:武汉大学医学院
# Bare FIDs use one login button and are checked in order. Add names (1024:武汉大学,1385:机构名) only when users must choose.
CHAOXING_FIDS=

# OAuth callback URI
# Option 1: Set explicitly for custom domains
#   Example: https://luojia-peds.whu.edu.cn/api/auth/callback/chaoxing
# Option 2: Leave empty to auto-build from COZE_PROJECT_DOMAIN_DEFAULT
#   Auto-generated: https://<COZE_PROJECT_DOMAIN_DEFAULT>/api/auth/callback/chaoxing
# IMPORTANT: Must exactly match the URL registered in Chaoxing platform (including protocol, domain, port, path)
CHAOXING_REDIRECT_URI=

# Teacher permission whitelist (comma-separated UIDs)
# Only users whose UID is in this list AND whose role includes "教师"/"teacher"/"管理员" will have teacher permissions.
# Example: 12345678,87654321,11223344
# Leave empty to grant student permissions to all users.
CHAOXING_TEACHER_UIDS=

# ============================================
# Chaoxing Form Synchronization (Optional)
# ============================================
# Leave blank until the official write API is provided by Chaoxing or school.
CHAOXING_FORM_WRITE_URL=
CHAOXING_FORM_WRITE_TOKEN=
CHAOXING_FORM_ID=
SYNC_WORKER_SECRET=

# ============================================
# Production Deployment Example
# ============================================
# For production deployment, configure the following in Coze platform:
#
# ENABLE_CHAOXING_AUTH=true
# CHAOXING_APPID=3826e62c2cc0455d86cf8c40c9de6308
# CHAOXING_SECRET=<store-in-secret-manager>
# CHAOXING_FIDS=1024,1385
# CHAOXING_REDIRECT_URI=https://<your-domain>/api/auth/callback/chaoxing
# CHAOXING_TEACHER_UIDS=<comma-separated-teacher-uids>
#
# IMPORTANT:
# 1. Store CHAOXING_SECRET in Coze secret manager, not in plain text
# 2. Register the exact CHAOXING_REDIRECT_URI in Chaoxing platform backend
# 3. Ensure HTTPS is enabled for production callback
# 4. Test with student and teacher accounts before going live

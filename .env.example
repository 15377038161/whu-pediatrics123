# Coze project database variables are injected after the database integration is enabled.
COZE_SUPABASE_URL=
COZE_SUPABASE_ANON_KEY=
COZE_SUPABASE_SERVICE_ROLE_KEY=

# Local and Coze development preview only. Production ignores this flag.
ENABLE_UI_PREVIEW=true
ENABLE_AI_FIXTURE=true
PREVIEW_SIGNING_SECRET=replace-with-a-long-random-value

# Coze injects DEV/PROD. Set DEV explicitly only when testing the built package locally with preview identity.
COZE_PROJECT_ENV=DEV

# Chaoxing OAuth. Keep disabled until APPID, APPKEY, FID and HTTPS callback are approved.
ENABLE_CHAOXING_AUTH=false
CHAOXING_APPID=
CHAOXING_SECRET=
CHAOXING_FIDS=
CHAOXING_REDIRECT_URI=
CHAOXING_TEACHER_UIDS=

# Chaoxing form synchronization. Leave blank until the official write API is provided.
CHAOXING_FORM_WRITE_URL=
CHAOXING_FORM_WRITE_TOKEN=
CHAOXING_FORM_ID=
SYNC_WORKER_SECRET=

# Coze runtime values are injected by the platform.
COZE_PROJECT_DOMAIN_DEFAULT=
